PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT secret — replace with a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_jwt_secret_here

# Groq API key — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
